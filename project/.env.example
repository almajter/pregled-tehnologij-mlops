# Rename to .env next to docker-compose.yml (chmod 600). Without it the
# stack runs with the dev defaults from docker-compose.yml — fine locally,
# never in production.
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me
POSTGRES_PASSWORD=change-me
# Extra Host headers / browser Origins MLflow must accept (see runbook):
MLFLOW_ALLOWED_HOSTS=localhost:*,mlflow:*,10.0.10.19:*,mlflow.alters.si
MLFLOW_CORS_ALLOWED_ORIGINS=https://mlflow.alters.si,http://10.0.10.19:5001,http://localhost:5001
ENTSOE_API_TOKEN=change-me
# Copy to .env next to docker-compose.yml (chmod 600). Unset keys fall back to
# the dev defaults in docker-compose.yml. Keep only the section for this machine.

# --- every machine that runs the api --------------------------------------
ENTSOE_API_TOKEN=change-me

# --- laptop: full stack, nothing else needed ------------------------------

# --- platform LXC: postgres minio minio-init mlflow -----------------------
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me
POSTGRES_PASSWORD=change-me
# Extra Host headers / browser Origins MLflow must accept (see runbook):
MLFLOW_ALLOWED_HOSTS=localhost:*,mlflow:*,10.0.10.19:*,mlflow.alters.si
MLFLOW_CORS_ALLOWED_ORIGINS=https://mlflow.alters.si,http://10.0.10.19:5001,http://localhost:5001

# --- api LXC: docker compose up -d --no-deps api --------------------------
# Never set this on the laptop, or the local api talks to the homelab.
MLFLOW_TRACKING_URI=http://10.0.10.19:5001
